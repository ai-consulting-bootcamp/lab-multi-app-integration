      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{\n  (() => {\n    const p = JSON.parse($json.output[0].content[0].text);\n    const ex = (p.example && typeof p.example === 'object')\n      ? Object.entries(p.example).filter(([k, v]) => v).map(([k, v]) => k + ': ' + v).join('\\n')\n      : (p.example || '');\n    return {\n      word: p.word,\n      meaning: p.meaning,\n      example: ex,\n      source: p.source || '',\n      date: $('Edit Fields').item.json.Date\n    };\n  })()\n}}",
        "options": {}
