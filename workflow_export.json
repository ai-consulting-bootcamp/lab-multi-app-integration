      "credentials": { "telegramApi": { "id": "REDACTED", "name": "Bens Support Bot KEY" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "version": 2, "leftValue": "", "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ String($json.message.chat.id) }}",
              "rightValue": "<OWNER_CHAT_ID>",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.message.reply_to_message.text }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9b92293d-0f29-4fed-bb6f-0fe5b88820c6",
      "name": "Is Owner Reply?",
