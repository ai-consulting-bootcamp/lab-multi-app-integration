      "typeVersion": 2.2,
      "position": [-352, 1824]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "sessionId",
              "type": "string",
              "value": "={{ ($json.message.reply_to_message.text.match(/Session:\\s*([A-Za-z0-9_-]+)/) || [])[1] || '' }}"
            },
            { "id": "s2", "name": "advice", "type": "string", "value": "={{ $json.message.text }}" },
            { "id": "s3", "name": "chatId", "type": "string", "value": "={{ String($json.message.chat.id) }}" }
          ]
        },
        "options": {}
      },
      "id": "9717e5bb-4aa0-4ac2-bc39-20a8dacc03d5",
      "name": "Extract Session and Advice",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-128, 1824]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "conditions": [
            {
              "id": "d1",
              "leftValue": "={{ $json.sessionId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b3d8cad5-4f26-470c-828d-c951c26bfd26",
      "name": "Has Session ID?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [96, 1824]
    },
    {
      "parameters": {
        "operation": "update",
        "dataTableId": { "__rl": true, "mode": "id", "value": "VUetiVPZaZWZEBYA" },
        "filters": { "conditions": [{ "keyName": "sessionId", "keyValue": "={{ $json.sessionId }}" }] },
        "columns": {
          "mappingMode": "defineBelow",
          "value": { "reply": "={{ $json.advice }}", "status": "answered", "delivered": false },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "6805f1df-c6c9-4795-8ec4-dfd7a2a62b90",
      "name": "Save Reply",
